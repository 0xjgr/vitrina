---
import Base from "../../layouts/Base.astro";
import { t } from "../../i18n";
import { obras, piezas, portada, rutaVia, vias } from "../../lib/obras";

export const getStaticPaths = () => [{ params: { via: t.rutas.via } }];

// Quién te recomendó cada cosa, o de dónde salió: `via` en la ficha. Se
// parece a los grupos, pero no hay que crear ninguna nota: el nombre basta.
const lista = vias(await obras());
---

<Base titulo={t.meLlegoPor} descripcion={t.viaDescripcion}>
  <div class="contenedor">
    <header class="titulo-pagina">
      <h1>{t.meLlegoPor}</h1>
      <p>{t.viaDescripcion}</p>
    </header>
    {lista.length === 0 && <p class="vacio">{t.viaVacio}</p>}
    <ul class="lista">
      {
        lista.map((v) => (
          <li>
            <a href={rutaVia(v.nombre)}>
              <span class="miniaturas" aria-hidden="true">
                {v.obras.slice(0, 3).map((o) =>
                  portada(o) ? <img src={portada(o)} alt="" loading="lazy" /> : <span class="hueco" style={`background:var(--${o.data.type})`} />,
                )}
              </span>
              <span>
                <strong>{v.nombre}</strong>
                <small>{piezas(v.obras.length)}</small>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .vacio {
    max-width: 60ch;
    color: var(--tenue);
  }
</style>
